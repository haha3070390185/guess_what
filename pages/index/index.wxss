.container {
  background: linear-gradient(180deg, #FFE6F0 0%, #FFD4E5 50%, #FFC0D9 100%);
  min-height: 100vh;
  padding: 60rpx 30rpx 100rpx;
  position: relative;
  overflow: hidden;
}

/* 漂浮心形 */
.floating-heart {
  position: fixed;
  width: 20px;
  height: 20px;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1);
  animation: floatHeart 6s ease-in-out infinite;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  opacity: 0.3;
  z-index: 0;
}

.floating-heart::before,
.floating-heart::after {
  content: '';
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1);
  border-radius: 50%;
  position: absolute;
}

.floating-heart::before {
  top: -50%;
  left: 0;
}

.floating-heart::after {
  top: 0;
  left: 50%;
}

/* 标题区域 */
.header {
  text-align: center;
  margin-bottom: 80rpx;
  position: relative;
  z-index: 1;
}

.title-section {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.emoji {
  font-size: 60rpx;
  margin: 0 20rpx;
}

.main-title {
  font-size: 72rpx;
  font-weight: bold;
  color: #FF4777;
  text-shadow: 3rpx 3rpx 6rpx rgba(255, 71, 119, 0.3);
  letter-spacing: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #FF8FB1;
  font-weight: 500;
}

/* 游戏卡片容器 */
.game-card-container {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  position: relative;
  z-index: 1;
}

/* 游戏卡片 */
.game-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 15rpx 40rpx rgba(255, 107, 157, 0.25);
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.game-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, rgba(255, 107, 157, 0.1), rgba(255, 71, 119, 0.1));
  border-radius: 50%;
  z-index: 0;
}

.game-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 25rpx rgba(255, 107, 157, 0.3);
}

.card-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #FFE6F0, #FFD4E5);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.color-icon {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}

.icon-text {
  font-size: 60rpx;
}

.card-content {
  flex: 1;
  position: relative;
  z-index: 1;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF4777;
  display: block;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 15rpx;
}

.card-tag {
  display: inline-block;
  background: linear-gradient(135deg, #FFE6F0, #FFD4E5);
  color: #FF6B9D;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.color-tag {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  color: #66BB6A;
}

.card-arrow {
  font-size: 40rpx;
  color: #FFB6C1;
  margin-left: 20rpx;
  position: relative;
  z-index: 1;
}

/* 底部 */
.footer {
  text-align: center;
  margin-top: 80rpx;
  position: relative;
  z-index: 1;
}

.footer-text {
  font-size: 24rpx;
  color: #FF8FB1;
  font-style: italic;
}

/* 动画 */
@keyframes floatHeart {
  0% {
    transform: translateY(100vh) rotate(-45deg);
    opacity: 0.3;
  }
  100% {
    transform: translateY(-100vh) rotate(-45deg);
    opacity: 0;
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.02);
  }
}

.animate-pulse {
  animation: pulse 3s ease-in-out infinite;
}

.animate-fade-in {
  animation: fadeIn 0.6s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
