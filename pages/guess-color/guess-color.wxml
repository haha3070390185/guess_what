<view class="container">
  <!-- 开始阶段 -->
  <view class="start-phase animate-fade-in" wx:if="{{gamePhase === 'start'}}">
    <view class="phase-header">
      <text class="phase-icon">🎨</text>
      <text class="phase-title">猜颜色游戏</text>
    </view>
    
    <view class="game-desc card">
      <text class="desc-title">游戏规则</text>
      <view class="desc-steps">
        <view class="step">
          <text class="step-num">1</text>
          <text class="step-text">一方选择一个颜色作为答案</text>
        </view>
        <view class="step">
          <text class="step-num">2</text>
          <text class="step-text">另一方从颜色中猜TA选的是哪个</text>
        </view>
        <view class="step">
          <text class="step-num">3</text>
          <text class="step-text">猜中即胜利，猜错可继续猜</text>
        </view>
      </view>
      
      <!-- 颜色预览 -->
      <view class="color-preview">
        <view class="preview-color" wx:for="{{colors}}" wx:key="id" 
              wx:if="{{index < 6}}" style="background-color: {{item.color}};">
        </view>
      </view>
      <text class="desc-tip">💕 共 {{colors.length}} 种颜色可选</text>
    </view>

    <view class="start-btn-container">
      <button class="btn-primary start-btn" bindtap="startSetup">
        开始游戏 💕
      </button>
      <button class="btn-secondary back-btn" bindtap="goBack">
        返回首页
      </button>
    </view>
  </view>

  <!-- 设置答案阶段 -->
  <view class="setup-phase animate-fade-in" wx:if="{{gamePhase === 'setup'}}">
    <view class="phase-header">
      <text class="phase-icon">🤫</text>
      <text class="phase-title">选择颜色</text>
    </view>

    <view class="setup-card card">
      <text class="setup-tip">请选择你喜欢的颜色</text>
      <text class="setup-subtip">交给TA来猜猜看~</text>
      
      <view class="color-grid">
        <view class="color-item" wx:for="{{colors}}" wx:key="id" 
              bindtap="selectTargetColor" data-id="{{item.id}}">
          <view class="color-circle" style="background-color: {{item.color}}; box-shadow: 0 8rpx 20rpx {{item.color}}40;">
          </view>
          <text class="color-name">{{item.name}}</text>
        </view>
      </view>

      <button class="btn-secondary cancel-btn" bindtap="goBack">取消</button>
    </view>
  </view>

  <!-- 猜测阶段 -->
  <view class="guessing-phase animate-fade-in" wx:if="{{gamePhase === 'guessing'}}">
    <view class="phase-header">
      <text class="phase-icon">🤔</text>
      <text class="phase-title">猜颜色</text>
    </view>

    <!-- 信息栏 -->
    <view class="info-card card">
      <view class="info-display">
        <view class="info-item">
          <text class="info-label">目标颜色</text>
          <view class="hidden-color">
            <text class="question-mark">?</text>
          </view>
        </view>
        <view class="info-item">
          <text class="info-label">已猜次数</text>
          <text class="info-value">{{attempts}}</text>
        </view>
      </view>
    </view>

    <!-- 颜色选择网格 -->
    <view class="guess-card card">
      <text class="guess-tip">猜猜TA选的是哪个颜色？</text>
      
      <view class="color-grid">
        <view class="color-item {{guessHistory.some(h => h.color.id === item.id && h.result === 'wrong') ? 'disabled' : ''}}" 
              wx:for="{{colors}}" wx:key="id"
              bindtap="makeGuess" data-id="{{item.id}}">
          <view class="color-circle {{guessHistory.some(h => h.color.id === item.id && h.result === 'wrong') ? 'wrong-color' : ''}}" 
                style="background-color: {{item.color}}; box-shadow: 0 8rpx 20rpx {{item.color}}40;">
            <text class="wrong-mark" wx:if="{{guessHistory.some(h => h.color.id === item.id && h.result === 'wrong')}}">✗</text>
          </view>
          <text class="color-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 提示信息 -->
    <view class="hint-popup {{showHint ? 'show' : ''}}" wx:if="{{showHint}}">
      <view class="hint-content {{hintType}}">
        <text class="hint-text">{{hintMessage}}</text>
      </view>
    </view>

    <!-- 猜测历史 -->
    <view class="history-card card" wx:if="{{guessHistory.length > 0}}">
      <text class="history-title">猜测记录</text>
      <view class="history-list">
        <view class="history-item" wx:for="{{guessHistory}}" wx:key="attempt">
          <text class="history-attempt">#{{item.attempt}}</text>
          <view class="history-color" style="background-color: {{item.color.color}};"></view>
          <text class="history-name">{{item.color.name}}</text>
          <text class="history-result {{item.result}}">
            {{item.result === 'correct' ? '✓ 正确' : '✗ 错误'}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <!-- 结果阶段 -->
  <view class="result-phase animate-fade-in" wx:if="{{gamePhase === 'result'}}">
    <view class="result-card card">
      <view class="result-icon">🎉</view>
      <text class="result-title">恭喜猜对啦！</text>
      
      <view class="result-color-display">
        <view class="result-color-circle" style="background-color: {{targetColor.color}}; box-shadow: 0 15rpx 40rpx {{targetColor.color}}60;">
        </view>
        <text class="result-color-name">{{targetColor.name}}</text>
      </view>

      <view class="result-info">
        <view class="info-item">
          <text class="info-label">猜测次数</text>
          <text class="info-value">{{attempts}} 次</text>
        </view>
      </view>

      <view class="result-message">
        <text>{{attempts <= 2 ? '💕 你们真有默契！' : attempts <= 4 ? '💗 还不错哦~' : '💖 再接再厉！'}}</text>
      </view>
    </view>

    <view class="result-btns">
      <button class="btn-primary" bindtap="playAgain">
        再玩一次 💕
      </button>
      <button class="btn-secondary" bindtap="goBack">
        返回首页
      </button>
    </view>
  </view>
</view>
