<view class="container">
  <view class="start-phase animate-fade-in" wx:if="{{gamePhase === 'start'}}">
    <view class="phase-header">
      <text class="phase-icon">🔢</text>
      <text class="phase-title">猜数字游戏</text>
    </view>
    
    <view class="game-desc card">
      <text class="desc-title">游戏规则</text>
      <view class="desc-steps">
        <view class="step">
          <text class="step-num">1</text>
          <text class="step-text">一方输入一个数字作为答案</text>
        </view>
        <view class="step">
          <text class="step-num">2</text>
          <text class="step-text">另一方来猜这个数字</text>
        </view>
        <view class="step">
          <text class="step-num">3</text>
          <text class="step-text">会提示"猜大了"或"猜小了"</text>
        </view>
      </view>
      <text class="desc-tip">💕 数字范围: 1 - 100</text>
    </view>

    <view class="start-btn-container">
      <button class="btn-primary start-btn" bindtap="startSetup">
        开始游戏 💕
      </button>
      <button class="btn-secondary back-btn" bindtap="goBack">
        返回首页
      </button>
    </view>
  </view>

  <view class="setup-phase animate-fade-in" wx:if="{{gamePhase === 'setup'}}">
    <view class="phase-header">
      <text class="phase-icon">🤫</text>
      <text class="phase-title">设置答案</text>
    </view>

    <view class="setup-card card">
      <text class="setup-tip">请输入你心中的数字</text>
      <text class="setup-range">范围: {{minRange}} - {{maxRange}}</text>
      
      <view class="input-wrapper">
        <input 
          class="setup-input" 
          type="number" 
          value="{{setupNumber}}" 
          bindinput="onSetupInput"
          placeholder="输入数字..."
          maxlength="3"
          focus
        />
      </view>

      <view class="setup-btns">
        <button class="btn-secondary" bindtap="goBack">取消</button>
        <button class="btn-primary" bindtap="confirmNumber">确认</button>
      </view>
    </view>

    <view class="secret-tip">
      <text>🔒 确认后数字将会隐藏，交给TA来猜吧~</text>
    </view>
  </view>

  <view class="guessing-phase animate-fade-in" wx:if="{{gamePhase === 'guessing'}}">
    <view class="phase-header">
      <text class="phase-icon">🤔</text>
      <text class="phase-title">猜数字</text>
    </view>

    <view class="range-card card">
      <view class="range-display">
        <view class="range-item">
          <text class="range-label">最小</text>
          <text class="range-value">{{currentMin}}</text>
        </view>
        <view class="range-center">
          <text class="range-icon">~</text>
          <text class="range-question">?</text>
          <text class="range-icon">~</text>
        </view>
        <view class="range-item">
          <text class="range-label">最大</text>
          <text class="range-value">{{currentMax}}</text>
        </view>
      </view>
    </view>

    <view class="guess-card card">
      <view class="guess-input-wrapper">
        <input 
          class="guess-input" 
          type="number" 
          value="{{guessNumber}}" 
          bindinput="onGuessInput"
          placeholder="输入你猜的数字"
          maxlength="3"
          focus
        />
      </view>
      
      <view class="attempts-info">
        <text>已猜 {{attempts}} 次</text>
      </view>

      <button class="btn-primary guess-btn" bindtap="makeGuess">
        我猜！💕
      </button>
    </view>

    <view class="hint-popup" wx:if="{{showHint}}">
      <view class="hint-content {{hintType}}">
        <text class="hint-text">{{hintMessage}}</text>
      </view>
    </view>

    <view class="history-card card" wx:if="{{hasHistory}}">
      <text class="history-title">猜测记录</text>
      <view class="history-list">
        <view class="history-item" wx:for="{{guessHistory}}" wx:key="attempt">
          <text class="history-attempt">#{{item.attempt}}</text>
          <text class="history-number">{{item.number}}</text>
          <text class="history-result {{item.result}}">
            {{item.resultText}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <view class="result-phase animate-fade-in" wx:if="{{gamePhase === 'result'}}">
    <view class="result-card card">
      <view class="result-icon">🎉</view>
      <text class="result-title">恭喜猜对啦！</text>
      
      <view class="result-info">
        <view class="info-item">
          <text class="info-label">正确答案</text>
          <text class="info-value">{{targetNumber}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">猜测次数</text>
          <text class="info-value">{{attempts}} 次</text>
        </view>
      </view>

      <view class="result-message">
        <text>{{resultMessage}}</text>
      </view>
    </view>

    <view class="result-btns">
      <button class="btn-primary" bindtap="playAgain">
        再玩一次 💕
      </button>
      <button class="btn-secondary" bindtap="goBack">
        返回首页
      </button>
    </view>
  </view>
</view>
