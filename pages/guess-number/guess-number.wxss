.container {
  background: linear-gradient(180deg, #FFE6F0 0%, #FFD4E5 50%, #FFC0D9 100%);
  min-height: 100vh;
  padding: 40rpx 30rpx;
}

/* 阶段标题 */
.phase-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.phase-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.phase-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF4777;
  text-shadow: 2rpx 2rpx 4rpx rgba(255, 71, 119, 0.2);
}

/* 开始阶段 */
.game-desc {
  margin-bottom: 60rpx;
}

.desc-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4777;
  display: block;
  margin-bottom: 30rpx;
  text-align: center;
}

.desc-steps {
  margin-bottom: 30rpx;
}

.step {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF4777);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 28rpx;
  color: #666;
  flex: 1;
}

.desc-tip {
  font-size: 26rpx;
  color: #FF6B9D;
  text-align: center;
  display: block;
  padding-top: 20rpx;
  border-top: 1rpx dashed #FFE0E9;
}

.start-btn-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.start-btn {
  width: 100%;
}

.back-btn {
  width: 100%;
}

/* 设置阶段 */
.setup-card {
  text-align: center;
}

.setup-tip {
  font-size: 32rpx;
  color: #FF4777;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.setup-range {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 40rpx;
}

.input-wrapper {
  margin-bottom: 40rpx;
}

.setup-input {
  width: 200rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FFE6F0, #FFD4E5);
  border: 3rpx solid #FF6B9D;
  border-radius: 20rpx;
  text-align: center;
  font-size: 48rpx;
  color: #FF4777;
  font-weight: bold;
  margin: 0 auto;
}

.setup-btns {
  display: flex;
  gap: 20rpx;
}

.setup-btns button {
  flex: 1;
}

.secret-tip {
  text-align: center;
  margin-top: 30rpx;
  font-size: 24rpx;
  color: #FF8FB1;
}

/* 猜测阶段 */
.range-card {
  margin-bottom: 30rpx;
}

.range-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.range-item {
  text-align: center;
}

.range-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.range-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF4777;
}

.range-center {
  text-align: center;
}

.range-icon {
  font-size: 32rpx;
  color: #FFB6C1;
}

.range-question {
  font-size: 60rpx;
  color: #FF4777;
  font-weight: bold;
  display: block;
  margin: 10rpx 0;
}

.guess-card {
  text-align: center;
  margin-bottom: 30rpx;
}

.guess-input-wrapper {
  margin-bottom: 20rpx;
}

.guess-input {
  width: 100%;
  height: 80rpx;
  background: white;
  border: 2rpx solid #FFE0E9;
  border-radius: 20rpx;
  text-align: center;
  font-size: 36rpx;
  color: #FF4777;
  box-sizing: border-box;
}

.guess-input:focus {
  border-color: #FF6B9D;
}

.attempts-info {
  margin-bottom: 30rpx;
  font-size: 26rpx;
  color: #999;
}

.guess-btn {
  width: 100%;
}

/* 提示弹窗 */
.hint-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  opacity: 0;
  transition: all 0.3s ease;
  z-index: 1000;
}

.hint-popup.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.hint-content {
  background: rgba(255, 255, 255, 0.95);
  padding: 30rpx 50rpx;
  border-radius: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
}

.hint-text {
  font-size: 32rpx;
  font-weight: bold;
}

.hint-content.low .hint-text {
  color: #FF9800;
}

.hint-content.high .hint-text {
  color: #FF5722;
}

.hint-content.success .hint-text {
  color: #4CAF50;
}

.hint-content.error .hint-text {
  color: #F44336;
}

/* 历史记录 */
.history-card {
  max-height: 400rpx;
  overflow-y: auto;
}

.history-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF4777;
  display: block;
  margin-bottom: 20rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 20rpx;
  background: linear-gradient(135deg, #FFF5F8, #FFE6F0);
  border-radius: 15rpx;
}

.history-attempt {
  font-size: 22rpx;
  color: #999;
  width: 80rpx;
}

.history-number {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4777;
  flex: 1;
  text-align: center;
}

.history-result {
  font-size: 24rpx;
  font-weight: bold;
  width: 100rpx;
  text-align: right;
}

.history-result.low {
  color: #FF9800;
}

.history-result.high {
  color: #FF5722;
}

.history-result.correct {
  color: #4CAF50;
}

/* 结果阶段 */
.result-card {
  text-align: center;
  margin-bottom: 40rpx;
}

.result-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF4777;
  display: block;
  margin-bottom: 30rpx;
}

.result-info {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
}

.info-item {
  text-align: center;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.info-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF4777;
}

.result-message {
  font-size: 28rpx;
  color: #FF6B9D;
  padding-top: 20rpx;
  border-top: 1rpx dashed #FFE0E9;
}

.result-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-btns button {
  width: 100%;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.5s ease-out;
}
