/* 全局样式 - 情侣主题 */
page {
  background: linear-gradient(135deg, #FFE6F0 0%, #FFD4E5 50%, #FFC0D9 100%);
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 心形动画 */
@keyframes floatHeart {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(-100vh) rotate(360deg);
    opacity: 0;
  }
}

.floating-heart {
  position: absolute;
  width: 20px;
  height: 20px;
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1);
  animation: floatHeart 3s ease-in-out infinite;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

/* 主容器样式 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  min-height: 100vh;
}

/* 标题样式 */
.title {
  font-size: 56rpx;
  font-weight: bold;
  color: #FF4777;
  text-align: center;
  margin-bottom: 20rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(255, 71, 119, 0.3);
}

.subtitle {
  font-size: 28rpx;
  color: #FF8FB1;
  text-align: center;
  margin-bottom: 60rpx;
}

/* 卡片样式 */
.card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  padding: 40rpx;
  margin: 20rpx 0;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 157, 0.2);
  backdrop-filter: blur(10rpx);
  width: 100%;
  box-sizing: border-box;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B9D, #FF4777);
  color: white;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 71, 119, 0.4);
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 10rpx rgba(255, 71, 119, 0.3);
}

.btn-secondary {
  background: white;
  color: #FF4777;
  border: 2rpx solid #FF6B9D;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 157, 0.2);
  transition: all 0.3s ease;
}

.btn-secondary:active {
  transform: scale(0.95);
  background: #FFF5F8;
}

/* 输入框样式 */
.input-box {
  background: white;
  border: 2rpx solid #FFE0E9;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  font-size: 36rpx;
  color: #FF4777;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.input-box:focus {
  border-color: #FF6B9D;
  box-shadow: 0 0 0 4rpx rgba(255, 107, 157, 0.1);
}

/* 心形图标 */
.heart-icon {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF4777);
  transform: rotate(-45deg);
  position: relative;
}

.heart-icon::before,
.heart-icon::after {
  content: '';
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF4777);
  border-radius: 50%;
  position: absolute;
}

.heart-icon::before {
  top: -20rpx;
  left: 0;
}

.heart-icon::after {
  top: 0;
  left: 20rpx;
}

/* 动画效果 */
@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}

.animate-fade-in {
  animation: fadeIn 0.5s ease-out;
}
